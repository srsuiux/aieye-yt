# ── Secrets & credentials — NEVER commit ─────────────────────
.env
*.env
client_secrets.json
youtube_token.pickle
*.pem
*.key
*.crt

# ── Personal / generated data (all under data/) ──────────────
# settings, topic queue + history, finished videos, YouTube credentials, experiments
data/
# your channel's identity (logo/banner prompts, metadata, images): this repo is only the framework
assets/channel/
# narrator samples (OpenAI's voices are public)
assets/voice_samples/

# ── Heavy media: never commit images, video or audio anywhere in the repo ──
# (generated pictures and videos belong under data/, which is ignored; use `git add -f` for a deliberate exception)
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.mp4
*.mov
*.m4a
*.mp3
*.wav

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/

# ── Logs, temp, local databases ──────────────────────────────
logs/
*.log
*.db
*.sqlite3
*.bak
*.backup
*.swp

# ── OS / editor ──────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
